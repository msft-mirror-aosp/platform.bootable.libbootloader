load("@gbl//licensing:licenses.bzl", "generate_license")
load("@gbl//toolchain:gbl_workspace_util.bzl", "GBL_RUST_VERSION")
load("@rules_rust//rust:defs.bzl", "rust_proc_macro")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

generate_license(
    name = "license",
    package_name = "rustversion",
)

rust_proc_macro(
    name = "rustversion",
    srcs = glob(["**/*.rs"]),
    edition = "2021",
    rustc_env = {
        "ANDROID_RUST_VERSION": GBL_RUST_VERSION,
    },
    rustc_flags = [
        "--cap-lints=allow",
        # Pretend to be soong so that it uses "ANDROID_RUST_VERSION" environment variable for rust
        # version. But there may be better option.
        "--cfg",
        "soong",
    ],
)
