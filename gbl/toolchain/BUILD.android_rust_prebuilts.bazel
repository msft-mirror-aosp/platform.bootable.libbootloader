load("@rules_rust//rust:defs.bzl", "rust_library", "rust_stdlib_filegroup")

package(default_visibility = ["//visibility:public"])

exports_files(["bin/*"])

filegroup(
    name = "binaries",
    srcs = glob([
        "bin/*",
        "lib/*",
        "lib64/*",
    ]),
)

# sysroot prebuilts for x86_64_unknown-linux-gnu
rust_stdlib_filegroup(
    name = "prebuilt_stdlibs",
    srcs = glob(["lib/rustlib/x86_64-unknown-linux-gnu/lib/*"]),
)

# sysroot prebuilts for x86_64_unknown-linux-musl.
# Exclude the self-contained/ subdirectory so self-contained/libc.a does not
# shadow dynamic musl sysroot libraries when dynamic linking is requested (e.g. proc-macros).
rust_stdlib_filegroup(
    name = "stdlib_x86_64-unknown-linux-musl",
    srcs = glob(
        ["lib/rustlib/x86_64-unknown-linux-musl/lib/**"],
        exclude = ["lib/rustlib/x86_64-unknown-linux-musl/lib/self-contained/**"],
    ),
)

# sysroot prebuilts for aarch64_unknown-uefi
rust_stdlib_filegroup(
    name = "aarch64-unknown-uefi_prebuilt_stdlibs",
    srcs = glob(["lib/rustlib/aarch64-unknown-uefi/lib/*"]),
)

# sysroot prebuilts for x86_64-unknown-uefi
rust_stdlib_filegroup(
    name = "x86_64-unknown-uefi_prebuilt_stdlibs",
    srcs = glob(["lib/rustlib/x86_64-unknown-uefi/lib/*"]),
)

rust_library(
    name = "liballoc",
    srcs = glob(["lib/rustlib/src/rust/library/alloc/src/**/*.rs"]),
    compile_data = glob(
        ["lib/rustlib/src/rust/library/alloc/src/**/*.md"],
        allow_empty = True,
    ),
    crate_name = "alloc",
    edition = "2024",
    deps = [
        "libcompiler_builtins",
        "libcore",
    ],
)

rust_library(
    name = "libcompiler_builtins",
    srcs = glob([
        "lib/rustlib/src/rust/library/compiler-builtins/compiler-builtins/src/**/*.rs",
        "lib/rustlib/src/rust/library/compiler-builtins/libm/src/math/**/*.rs",
    ]),
    compile_data = glob(
        ["lib/rustlib/src/rust/library/compiler-builtins/compiler-builtins/src/**/*.md"],
        allow_empty = True,
    ),
    crate_features = [
        "compiler-builtins",
        "core",
        "default",
        "mem",
    ],
    crate_name = "compiler_builtins",
    edition = "2024",
    rustc_flags = [
        "--cap-lints=allow",
    ] + select(
        {
            # This is needed otherwise x64 can't find __gnu_h2f_ieee/__gnu_f2h_ieee symbols.
            "@gbl//toolchain:gbl_rust_uefi_x86_64": ["--cfg=f16_enabled"],
            "@gbl//toolchain:gbl_rust_uefi_x86_64_debug": ["--cfg=f16_enabled"],
            "//conditions:default": [],
        },
    ),
    deps = ["libcore"],
)

rust_library(
    name = "libcore",
    srcs = glob([
        "lib/rustlib/src/rust/library/core/src/**/*.rs",
        "lib/rustlib/src/rust/library/stdarch/crates/core_arch/src/**/*.rs",
        "lib/rustlib/src/rust/library/portable-simd/crates/core_simd/src/**/*.rs",
    ]),
    compile_data = glob(
        [
            "lib/rustlib/src/rust/library/core/src/**/*.md",
            "lib/rustlib/src/rust/library/core/primitive_docs/*.md",
            "lib/rustlib/src/rust/library/stdarch/crates/core_arch/src/**/*.md",
            "lib/rustlib/src/rust/library/portable-simd/crates/core_simd/src/**/*.md",
        ],
        allow_empty = True,
    ),
    crate_features = ["stdsimd"],
    crate_name = "core",
    edition = "2024",
    rustc_flags = ["--cap-lints=allow"],
)
