load("@gbl//licensing:licenses.bzl", "generate_license")
load("@gbl//toolchain:gbl_toolchain.bzl", "link_static_cc_library")
load("@rules_cc//cc:defs.bzl", "cc_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

generate_license(
    name = "license",
    package_name = "open-dice",
)

exports_files(glob(["include/**/*.h"]))

# Multialg variant supporting Ed25519, P-256, P-384, ML-DSA-65, and ML-DSA-87.
cbor_baremetal_multialg_srcs = [
    "src/boringssl_hash_kdf_ops.c",
    "src/cbor_cert_op.c",
    "src/cbor_writer.c",
    "src/boringssl_multialg_ops.c",
    "src/boringssl_ecdsa_utils.c",
    "src/boringssl_mldsa_utils.c",
    "src/dice.c",
    "src/utils.c",
]

cbor_baremetal_hdrs = glob(["include/**/*.h"]) + ["@gbl//libopendice:bindgen/dice/dice.h"]

cc_library(
    name = "libopen_dice_cbor_baremetal_multialg",
    srcs = cbor_baremetal_multialg_srcs,
    hdrs = cbor_baremetal_hdrs,
    includes = [
        "include",
        "include/dice/config/android",
        "include/dice/config/boringssl_multialg",
    ],
    deps = [
        "@boringssl//:crypto_baremetal",
        "@gbl//libc:headers",
    ],
)

link_static_cc_library(
    name = "libopen_dice_cbor_baremetal_multialg_static",
    cc_library = ":libopen_dice_cbor_baremetal_multialg",
)

android_srcs = [
    "src/cbor_reader.c",
    "src/android.c",
]

android_hdrs = [
    "include/dice/android.h",
]

cc_library(
    name = "libopen_dice_android_baremetal_multialg",
    srcs = android_srcs,
    hdrs = android_hdrs,
    includes = ["include"],
    deps = [
        ":libopen_dice_cbor_baremetal_multialg",
        "@boringssl//:crypto_baremetal",
        "@gbl//libc:headers",
    ],
)

link_static_cc_library(
    name = "libopen_dice_android_baremetal_multialg_static",
    cc_library = ":libopen_dice_android_baremetal_multialg",
)
